---
import Default from '@astrojs/starlight/components/Footer.astro';
import consequentialMark from '../assets/consequential-mark.svg';
---

<Default><slot /></Default>

<p class="consequential-credit">
	<img class="consequential-mark" src={consequentialMark.src} alt="" />
	Maintained by <a href="https://consequential.io" target="_blank" rel="noopener noreferrer">Consequential</a>
</p>

<style>
	.consequential-credit {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
		text-align: center;
		opacity: 0.85;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	.consequential-mark {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}

	.consequential-credit a {
		color: inherit;
		text-decoration: none;
	}

	.consequential-credit a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
